# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Database Configuration (Aiven PostgreSQL)
# Get this from your Aiven console: Service Overview -> Connection Information
DATABASE_URL=postgresql://avnadmin:password@your-project.aivencloud.com:12345/defaultdb?sslmode=require

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh

# Secret Key
SECRET_KEY=your-secret-key-here
